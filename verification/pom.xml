<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.knowpool</groupId>
        <artifactId>know-pool</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>verification</artifactId>
    <packaging>pom</packaging>
    <name>Know Pool Integration Verification</name>
    <dependencies>
        <dependency>
            <groupId>cn.knowpool</groupId>
            <artifactId>front</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.knowpool</groupId>
            <artifactId>server</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-contract-tools</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>python</executable>
                            <arguments>
                                <argument>-m</argument>
                                <argument>unittest</argument>
                                <argument>discover</argument>
                                <argument>-s</argument>
                                <argument>scripts/contract</argument>
                                <argument>-p</argument>
                                <argument>test_*.py</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-evaluation-tools</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>python</executable>
                            <arguments>
                                <argument>-m</argument>
                                <argument>unittest</argument>
                                <argument>discover</argument>
                                <argument>-s</argument>
                                <argument>scripts/evaluation</argument>
                                <argument>-p</argument>
                                <argument>test_*.py</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-live-integration</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>python</executable>
                            <arguments>
                                <argument>scripts/contract/run_live.py</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-contract-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <executable>python</executable>
                            <arguments>
                                <argument>scripts/contract/verify.py</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
