<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>cn.knowpool</groupId><artifactId>know-pool</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>front</artifactId>
  <packaging>pom</packaging>
  <name>Know Pool Frontend</name>
  <build><plugins><plugin>
    <groupId>com.github.eirslett</groupId><artifactId>frontend-maven-plugin</artifactId><version>1.15.1</version>
    <configuration><installDirectory>${project.build.directory}/toolchain</installDirectory><workingDirectory>${project.basedir}</workingDirectory></configuration>
    <executions>
      <execution><id>install-frontend-toolchain</id><phase>generate-resources</phase><goals><goal>install-node-and-pnpm</goal></goals><configuration><nodeVersion>${node.version}</nodeVersion><pnpmVersion>${pnpm.version}</pnpmVersion></configuration></execution>
      <execution><id>install-frozen-dependencies</id><phase>generate-resources</phase><goals><goal>pnpm</goal></goals><configuration><arguments>install --frozen-lockfile</arguments></configuration></execution>
      <execution><id>lint-frontend</id><phase>test</phase><goals><goal>pnpm</goal></goals><configuration><arguments>lint</arguments></configuration></execution>
      <execution><id>check-frontend-format</id><phase>test</phase><goals><goal>pnpm</goal></goals><configuration><arguments>format:check</arguments></configuration></execution>
      <execution><id>test-frontend-coverage</id><phase>test</phase><goals><goal>pnpm</goal></goals><configuration><arguments>test:coverage</arguments></configuration></execution>
      <execution><id>build-frontend</id><phase>prepare-package</phase><goals><goal>pnpm</goal></goals><configuration><arguments>build</arguments></configuration></execution>
    </executions>
  </plugin></plugins></build>
</project>
