{
  "name": "know-pool-prototypes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile=artifacts/vitest.json && node scripts/merge-evidence.mjs",
    "test:live": "node scripts/check-live.mjs",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "axios": "1.13.2",
    "pinia": "3.0.4",
    "vue": "3.5.24",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-vue": "6.0.2",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.5.1",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "39.0.1",
    "vite": "7.2.2",
    "vitest": "3.2.4"
  }
}
